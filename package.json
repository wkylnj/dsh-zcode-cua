{
    "name":  "dsh-zcode-cua",
    "displayName":  "DSH ZCode Computer Control",
    "version": "1.3.0",
    "description":  "把 ZCode 的电脑控制（Computer Use）接进 DeepSeek Harness：点击、打字、读无障碍树与截图。",
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "computer-use",
                     "cua",
                     "zcode",
                     "mcp",
                     "mcp-server",
                     "gui-automation",
                     "windows"
                 ],
    "license":  "MIT",
    "author":  "wkylnj",
    "type":  "module",
    "main":  "./index.js",
    "bin":  {
                "dsh-zcode-cua":  "./server/index.js"
            },
    "icon":  "./icon.svg",
    "exports":  {
                    ".":  "./index.js",
                    "./server":  "./server/index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "server",
                  "locale/*.json",
                  "docs",
                  "skills",
                  "icon.svg",
                  "README.md",
                  "README.zh.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ]
                           }
            },
    "engines":  {
                    "node":  "\u003e=18.17.0"
                },
    "os":  [
               "win32"
           ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/wkylnj/dsh-zcode-cua.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/wkylnj/dsh-zcode-cua/issues"
             },
    "homepage":  "https://github.com/wkylnj/dsh-zcode-cua#readme"
}
